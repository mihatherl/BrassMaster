{
  "name": "brass-master",
  "private": true,
  "version": "2.45.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:web": "VITE_TARGET=web npm run build",
    "build:app": "VITE_TARGET=app npm run build",
    "build:dev": "VITE_CHANNEL=dev npm run build:app",
    "check:web": "node tools/check-web-bundle.mjs",
    "check:channel": "node tools/check-channel.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "VITE_TARGET=app vitest run",
    "test:watch": "VITE_TARGET=app vitest",
    "svg": "tsx tools/stave-to-svg.mts",
    "shots": "tsx tools/shots.mts",
    "tunes": "tsx tools/tune-sheet.mts",
    "cells": "tsx tools/cell-sheet.mts",
    "themes-sheet": "tsx tools/theme-sheet.mts",
    "midi": "tsx tools/midi-to-theme.mts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "happy-dom": "^20.11.1",
    "oxlint": "^1.75.0",
    "playwright-core": "^1.62.1",
    "tsx": "^4.20.7",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
