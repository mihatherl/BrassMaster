{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /*
     * `tools/channel.mjs` is plain JavaScript on purpose: the build imports it
     * and so does `tools/check-channel.mjs`, which runs under bare node after
     * the build, with no TypeScript in reach. Letting the config see it typed
     * by inference beats keeping a second declaration file in step with it.
     */
    "allowJs": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "tools/channel.mjs"]
}
